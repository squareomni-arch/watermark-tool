{
    "trigger": {
        "mode": "capslock",
        "poll_interval": 0.1
    },
    "features": {
        "overlay": true,
        "ai": true,
        "answer_all": true,
        "detail_max_lines": 20,
        "detail_max_chars": 800
    },
    "gemini": {
        "api_key": "",
        "model": "gemini-3.1-flash-lite",
        "fallback_models": [
            "gemini-3.5-flash-lite",
            "gemini-flash-lite-latest"
        ],
        "timeout": 12,
        "max_attempts": 2,
        "retries_per_model": 1,
        "max_image_dimension": 1920,
        "detail_timeout": 40,
        "detail_image_dimension": 2560
    },
    "update": {
        "enabled": true,
        "check_url": "https://cdn.jsdelivr.net/gh/squareomni-arch/watermark-tool@main/dist/version.json",
        "check_interval_hours": 6
    },
    "watermark": {
        "text": "Hello",
        "color": "#FFD700",
        "opacity": 0.7,
        "font_family": "Segoe UI",
        "font_size": 16,
        "bold": true,
        "corner": "top_right",
        "margin_x": 28,
        "margin_y": 20,
        "padding": 4,
        "max_width": 620,
        "box_color": "#121212",
        "box_opacity": 0.82
    }
}
