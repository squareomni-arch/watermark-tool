{
    "trigger": {
        "mode": "capslock",
        "poll_interval": 0.1
    },
    "features": {
        "overlay": true,
        "ai": true
    },
    "gemini": {
        "api_key": "",
        "model": "gemini-3.1-flash-lite",
        "fallback_models": [
            "gemini-flash-lite-latest",
            "gemini-3.5-flash-lite"
        ],
        "timeout": 12,
        "max_attempts": 2
    },
    "update": {
        "enabled": true,
        "check_url": "https://cdn.jsdelivr.net/gh/squareomni-arch/watermark-tool@main/dist/version.json",
        "check_interval_hours": 6
    },
    "watermark": {
        "text": "Hello",
        "color": "#FFD700",
        "opacity": 0.7,
        "font_family": "Segoe UI",
        "font_size": 16,
        "bold": true,
        "corner": "top_right",
        "margin_x": 28,
        "margin_y": 20,
        "padding": 4
    }
}
